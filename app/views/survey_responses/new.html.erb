<main class="app-shell">
  <section class="top-bar">
    <div>
      <p class="eyebrow">Survey</p>
      <h1><%= @assignment.survey.title %></h1>
    </div>
    <%= link_to "戻る", root_path, class: "button button-secondary" %>
  </section>

  <% flash.each do |type, message| %>
    <div class="flash <%= type %>" data-controller="flash"><%= message %></div>
  <% end %>

  <%= form_with url: survey_assignment_response_path(@assignment), method: :post, class: "response-form" do %>
    <% @assignment.survey.survey_questions.ordered.each do |question| %>
      <fieldset class="question-block">
        <legend>
          <span>Q<%= question.order_index %></span>
          <%= question.body %>
        </legend>

        <% selected_score = Integer(@answers[question.id.to_s], exception: false) %>
        <% selected_score = nil unless selected_score&.between?(ScoreAnswer::MIN_SCORE, ScoreAnswer::MAX_SCORE) %>
        <% display_score = selected_score || "未選択" %>
        <% slider_score = selected_score || ScoreAnswer::DEFAULT_SCORE %>

        <div class="score-slider" data-controller="score-slider">
          <div class="score-value" aria-live="polite">
            <span>現在の評価</span>
            <strong data-score-slider-target="value"><%= display_score %></strong>
          </div>

          <%= hidden_field_tag "answers[#{question.id}]", selected_score, data: { score_slider_target: "input" } %>
          <%= tag.input type: "range",
                        id: "score_range_#{question.id}",
                        class: "score-range",
                        min: ScoreAnswer::MIN_SCORE,
                        max: ScoreAnswer::MAX_SCORE,
                        step: 1,
                        value: slider_score,
                        data: {
                          score_slider_target: "range",
                          action: "input->score-slider#select change->score-slider#select"
                        },
                        aria: { label: "Q#{question.order_index}の評価" } %>

          <div class="score-scale" aria-hidden="true">
            <% score_steps = ScoreAnswer::MAX_SCORE - ScoreAnswer::MIN_SCORE %>
            <% (ScoreAnswer::MIN_SCORE..ScoreAnswer::MAX_SCORE).each do |score| %>
              <% score_ratio = (score - ScoreAnswer::MIN_SCORE).to_f / score_steps %>
              <% score_percent = score_ratio * 100 %>
              <% score_offset = 20 * (0.5 - score_ratio) %>
              <span style="--score-left: calc(<%= score_percent %>% <%= score_offset.negative? ? "-" : "+" %> <%= score_offset.abs %>px)"><%= score %></span>
            <% end %>
          </div>
        </div>

        <div class="score-labels">
          <span>まったくそう思わない</span>
          <span>とてもそう思う</span>
        </div>
      </fieldset>
    <% end %>

    <div class="form-actions">
      <%= submit_tag "送信する", class: "button button-primary" %>
    </div>
  <% end %>
</main>
