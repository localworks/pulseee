<% progress_labels = [ "仕事", "直近\n1ヶ月", "周囲の\n人々", "満足度", "やりがい" ] %>
<% answer_options = [
  [ 5, "そうだ" ],
  [ 4, "まあそうだ" ],
  [ 3, "どちらでも言えない" ],
  [ 2, "ややちがう" ],
  [ 1, "ちがう" ]
] %>

<main class="response-page">
  <% flash.each do |type, message| %>
    <div class="flash <%= type %>"><%= message %></div>
  <% end %>

  <nav class="survey-progress" aria-label="サーベイの進捗">
    <% progress_labels.each.with_index(1) do |label, index| %>
      <% active = index == progress_labels.length %>
      <div class="survey-progress-step <%= "is-active" if active %>">
        <span class="survey-progress-node">
          <span class="survey-progress-number"><%= index %></span>
          <% unless active %>
            <span class="survey-progress-check" aria-hidden="true">✓</span>
          <% end %>
        </span>
        <span class="survey-progress-label"><%= simple_format(label, {}, wrapper_tag: "span") %></span>
      </div>
    <% end %>
  </nav>

  <header class="response-hero">
    <%= link_to "戻る", root_path, class: "button button-secondary response-back" %>
    <p class="eyebrow">Survey</p>
    <h1><%= @assignment.survey.title %></h1>
  </header>

  <section class="response-prompt">
    <h2>あなたの仕事についてうかがいます。最もあてはまるものを選択してください。</h2>
  </section>

  <%= form_with url: survey_assignment_response_path(@assignment), method: :post, class: "response-form response-choice-form" do %>
    <% @assignment.survey.survey_questions.ordered.each do |question| %>
      <fieldset class="question-block">
        <legend>
          <span><%= question.order_index %>.</span>
          <%= question.body %>
        </legend>

        <% selected_score = Integer(@answers[question.id.to_s], exception: false) %>
        <% selected_score = nil unless selected_score&.between?(ScoreAnswer::MIN_SCORE, ScoreAnswer::MAX_SCORE) %>

        <div class="answer-choice-group">
          <% answer_options.each do |score, label| %>
            <% input_id = "answer_#{question.id}_#{score}" %>
            <label class="answer-choice" for="<%= input_id %>">
              <%= radio_button_tag "answers[#{question.id}]",
                                   score,
                                   selected_score == score,
                                   id: input_id,
                                   class: "answer-choice-input",
                                   required: true %>
              <span class="answer-choice-label"><%= label %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>

    <div class="form-actions">
      <%= submit_tag "送信する", class: "button button-primary" %>
    </div>
  <% end %>
</main>
