<main class="app-shell">
  <section class="top-bar">
    <div>
      <p class="eyebrow">Survey</p>
      <h1><%= @assignment.survey.title %></h1>
    </div>
    <%= link_to root_path, class: "button button-secondary button-back" do %>
      <span aria-hidden="true">←</span>
      <span>戻る</span>
    <% end %>
  </section>

  <% flash.each do |type, message| %>
    <div class="flash <%= type %>" data-controller="flash"><%= message %></div>
  <% end %>

  <% questions = @assignment.survey.survey_questions.ordered.to_a %>
  <% score_options = [
    [1, "ちがう"],
    [2, "ややちがう"],
    [3, "どちらとも言えない"],
    [4, "まあそうだ"],
    [5, "そうだ"]
  ] %>

  <%= form_with url: survey_assignment_response_path(@assignment),
                method: :post,
                class: "response-form",
                data: { controller: "score-choice" } do %>
    <ol class="question-progress" aria-label="回答状況">
      <% questions.each do |question| %>
        <% selected_score = Integer(@answers[question.id.to_s], exception: false) %>
        <% selected_score = nil unless selected_score&.between?(ScoreAnswer::MIN_SCORE, ScoreAnswer::MAX_SCORE) %>
        <li class="question-progress-item <%= "is-answered" if selected_score %>"
            data-score-choice-target="status"
            data-question-id="<%= question.id %>">
          <span class="question-progress-number"><%= question.order_index %></span>
        </li>
      <% end %>
    </ol>

    <% questions.each do |question| %>
      <fieldset class="question-block">
        <legend>
          <span>Q<%= question.order_index %></span>
          <%= question.body %>
        </legend>

        <% selected_score = Integer(@answers[question.id.to_s], exception: false) %>
        <% selected_score = nil unless selected_score&.between?(ScoreAnswer::MIN_SCORE, ScoreAnswer::MAX_SCORE) %>

        <div class="score-choice-group">
          <% score_options.each do |score, label| %>
            <% input_id = "answer_#{question.id}_#{score}" %>
            <label class="score-choice <%= "is-selected" if selected_score == score %>" for="<%= input_id %>">
              <%= radio_button_tag "answers[#{question.id}]",
                                   score,
                                   selected_score == score,
                                   id: input_id,
                                   class: "score-choice-input",
                                   required: true,
                                   data: {
                                     action: "change->score-choice#select",
                                     question_id: question.id
                                   } %>
              <span class="score-choice-dot" aria-hidden="true"></span>
              <span><%= label %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>

    <section class="free-text-question" aria-labelledby="free-text-question-label">
      <label id="free-text-question-label" for="free_text_answer">
        今週、よかったことや気になったことを教えてください。（任意）
      </label>
      <p id="free-text-answer-help" class="free-text-answer-help">
        回答は氏名やメールアドレスとは紐づけずに保存されます。個人を特定できる情報は入力しないでください。
      </p>
      <%= text_area_tag :free_text_answer,
                        @free_text_answer,
                        id: "free_text_answer",
                        class: "free-text-answer-input",
                        rows: 6,
                        maxlength: FreeTextAnswer::MAX_LENGTH,
                        aria: { describedby: "free-text-answer-help" } %>
    </section>

    <div class="form-actions">
      <%= submit_tag "送信する", class: "button button-primary button-submit" %>
    </div>
  <% end %>
</main>
