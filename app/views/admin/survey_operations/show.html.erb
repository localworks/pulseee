<% content_for(:title, "サーベイ運用") %>

<main class="app-shell admin-operation-shell">
  <% if flash[:notice].present? %>
    <div class="flash notice"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert].present? %>
    <div class="flash alert"><%= flash[:alert] %></div>
  <% end %>

  <div class="top-bar">
    <div>
      <p class="eyebrow">Admin operation</p>
      <h1>サーベイ運用</h1>
    </div>
    <div class="top-actions">
      <%= link_to "Rails Admin", rails_admin_path, class: "button button-secondary" %>
    </div>
  </div>

  <section class="work-panel admin-operation-panel">
    <div class="admin-operation-status">
      <div>
        <p class="muted">今週分サーベイ</p>
        <p class="admin-operation-value"><%= @current_week_survey&.title || "未作成" %></p>
      </div>
    </div>

    <div class="admin-operation-actions">
      <div>
        <h2>今週分を作成</h2>
        <p class="muted">今週のサーベイを作成し、有効化します。すでにある場合は二重作成しません。</p>
      </div>
      <%= button_to "サーベイ作成ジョブを登録",
                    create_current_week_survey_admin_survey_operation_path,
                    method: :post,
                    class: "button button-primary" %>
    </div>
  </section>
</main>
