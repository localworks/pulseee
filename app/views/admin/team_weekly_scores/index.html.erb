<main class="admin-operation-shell team-score-shell">
  <nav class="home-nav team-score-nav" aria-label="スコア画面操作">
    <%= link_to "ホーム", root_path, class: "home-nav-btn" %>
    <% if current_user.system_admin? %>
      <%= link_to "管理画面", rails_admin_path, class: "home-nav-btn" %>
    <% end %>
    <%= button_to "ログアウト", logout_path, method: :delete, class: "home-nav-btn" %>
  </nav>

  <% flash.each do |type, message| %>
    <div class="flash <%= type %> home-flash" data-controller="flash"><%= message %></div>
  <% end %>

  <section class="admin-operation-panel team-score-panel" aria-labelledby="team-score-heading">
    <div class="team-score-heading-block">
      <p class="team-score-kicker">Weekly Score</p>
      <h1 id="team-score-heading">チーム別スコア推移</h1>
      <p>週次集計されたチーム別の全体平均と質問ごとの平均を確認できます。</p>
    </div>

    <% if @weeks.any? %>
      <div class="team-score-summary" aria-label="集計サマリー">
        <div>
          <span class="team-score-summary-key">最新全体平均</span>
          <span class="team-score-summary-value"><%= number_with_precision(@overall_latest_average, precision: 2) %></span>
        </div>
        <div>
          <span class="team-score-summary-key">前週比</span>
          <span class="team-score-summary-value team-score-delta <%= score_delta_class(@overall_delta) %>"><%= score_delta_text(@overall_delta) %></span>
        </div>
        <div>
          <span class="team-score-summary-key">最新週の回答数</span>
          <span class="team-score-summary-value"><%= @latest_response_count %></span>
        </div>
        <div>
          <span class="team-score-summary-key">チーム数</span>
          <span class="team-score-summary-value"><%= @group_names.size %></span>
        </div>
      </div>

      <% if current_user.system_admin? && @weekly_response_rates.any? %>
        <section class="team-response-rate-panel" aria-labelledby="team-response-rate-heading">
          <div class="team-score-chart-copy">
            <p class="team-score-kicker">Response Rate</p>
            <h2 id="team-response-rate-heading">週ごとの回答率</h2>
            <p>サーベイ対象者への割当数に対する回答済み数を表示しています。</p>
          </div>

          <div class="team-score-table-wrap">
            <table class="team-score-table team-response-rate-table">
              <thead>
                <tr>
                  <th>週</th>
                  <th>全体回答率</th>
                  <th>回答済み</th>
                  <th>チーム/部署別</th>
                </tr>
              </thead>
              <tbody>
                <% @weekly_response_rates.each do |week_rate| %>
                  <tr>
                    <td><%= score_date_label(week_rate.week_start_on) %></td>
                    <td><strong><%= response_rate_text(week_rate.rate) %></strong></td>
                    <td><%= week_rate.submitted_count %>/<%= week_rate.assigned_count %></td>
                    <td>
                      <div class="team-response-rate-groups">
                        <% week_rate.group_rates.each do |group_rate| %>
                          <span>
                            <%= group_rate.group_name %>
                            <strong><%= response_rate_text(group_rate.rate) %></strong>
                            <small><%= group_rate.submitted_count %>/<%= group_rate.assigned_count %></small>
                          </span>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <section class="team-score-chart-panel" aria-labelledby="team-score-overall-chart-heading">
        <div class="team-score-chart-copy">
          <p class="team-score-kicker">Overall Trend</p>
          <h2 id="team-score-overall-chart-heading">全チーム平均の推移</h2>
          <p>スコア1〜5の縦軸で、週ごとの全体傾向を表示しています。</p>
        </div>
        <div class="team-score-line-chart" data-controller="chart-note" data-action="pointerleave->chart-note#hide">
          <svg viewBox="0 0 800 300" role="img" aria-label="全チーム平均の折れ線グラフ。メモがある週は強調表示されています。">
            <%# Y軸グリッド・ラベル（1〜5） %>
            <% overall_chart_y_axis.each do |item| %>
              <line x1="52" y1="<%= item[:y] %>" x2="784" y2="<%= item[:y] %>"
                    class="<%= item[:score] == 1 ? 'team-score-chart-axis' : 'team-score-chart-grid' %>" />
              <text x="44" y="<%= item[:y] + 4 %>" class="team-score-chart-label-y"><%= item[:score] %></text>
            <% end %>
            <%# Y軸縦線 %>
            <line x1="52" y1="18" x2="52" y2="252" class="team-score-chart-axis" />
            <%# データ折れ線と点 %>
            <% overall_pts = overall_chart_points(@overall_points) %>
            <polyline points="<%= overall_pts.map { |p| "#{p[:x]},#{p[:y]}" }.join(' ') %>" class="team-score-chart-line" />
            <% overall_pts.each do |point| %>
              <% note = @weekly_score_notes_by_week[point.fetch(:week_start_on)] %>
              <a href="<%= admin_team_weekly_scores_path(note_week: point.fetch(:week_start_on), anchor: "weekly-score-note-#{point.fetch(:week_start_on)}") %>"
                 aria-label="<%= score_date_label(point.fetch(:week_start_on)) %>の週次メモ<%= 'あり' if note %>"
                 <% if note %>
                   aria-describedby="weekly-score-note-tooltip-<%= point.fetch(:week_start_on) %>"
                   data-week="<%= point.fetch(:week_start_on) %>"
                   data-action="pointerenter->chart-note#show pointerleave->chart-note#hide focus->chart-note#show blur->chart-note#hide"
                 <% end %>>
                <circle cx="<%= point[:x] %>" cy="<%= point[:y] %>" r="<%= note ? 7 : 5 %>" class="team-score-chart-dot <%= 'has-note' if note %>" />
              </a>
            <% end %>
            <%# X軸ラベル（多い場合は自動間引き） %>
            <% overall_chart_x_labels(@overall_points).each do |item| %>
              <text x="<%= item[:x] %>" y="278" class="team-score-chart-label-x"><%= item[:label] %></text>
            <% end %>
          </svg>
          <div class="team-score-chart-annotations" aria-label="グラフ上の週次メモ">
            <% overall_pts.each do |point| %>
              <% note = @weekly_score_notes_by_week[point.fetch(:week_start_on)] %>
              <% next unless note %>
              <% tooltip_alignment = "is-right-aligned" if point.fetch(:x) > TeamWeeklyScoresHelper::OVERALL_W * 0.75 %>
              <% delta = point[:delta] %>
              <div id="weekly-score-note-tooltip-<%= point.fetch(:week_start_on) %>"
                 class="team-score-chart-note <%= tooltip_alignment %>"
                 role="tooltip"
                 data-chart-note-target="tooltip"
                 data-week="<%= point.fetch(:week_start_on) %>"
                 hidden
                 style="--point-x: <%= (point.fetch(:x) * 100 / TeamWeeklyScoresHelper::OVERALL_W).round(2) %>%; --point-y: <%= (point.fetch(:y) * 100 / TeamWeeklyScoresHelper::OVERALL_H).round(2) %>%;">
                <div class="team-score-chart-note-meta">
                  <span><%= score_date_label(point.fetch(:week_start_on)) %></span>
                  <strong class="team-score-chart-note-score"><%= number_with_precision(point.fetch(:value), precision: 2) %></strong>
                  <em class="team-score-chart-note-delta <%= delta ? score_delta_class(delta) : "is-new" %>">
                    <%= delta ? score_delta_text(delta) : "初回" %>
                  </em>
                </div>
                <strong><%= note.body.truncate(48) %></strong>
              </div>
            <% end %>
          </div>
        </div>

      <details class="weekly-score-notes" <%= 'open' if @notes_expanded %>>
        <summary class="weekly-score-notes-heading">
          <div>
            <p class="team-score-kicker">Weekly Notes</p>
            <h2 id="weekly-score-notes-heading">スコア変化のメモ</h2>
            <p>月ごとに、グラフ上で強調表示された点のメモを確認できます。</p>
          </div>
          <span class="weekly-score-notes-toggle" aria-hidden="true">
            <span class="weekly-score-notes-toggle-closed">メモを表示</span>
            <span class="weekly-score-notes-toggle-open">閉じる</span>
            <i></i>
          </span>
        </summary>

        <div class="weekly-score-notes-content">
          <nav class="weekly-score-notes-pagination" aria-label="メモの月切り替え">
            <% if @previous_note_month %>
              <%= link_to "← 前の月", admin_team_weekly_scores_path(note_month: @previous_note_month.strftime("%Y-%m"), anchor: "weekly-score-notes-heading"), class: "button button-secondary" %>
            <% else %>
              <span></span>
            <% end %>
            <strong><%= @note_month.strftime("%Y年%-m月") %></strong>
            <% if @next_note_month %>
              <%= link_to "次の月 →", admin_team_weekly_scores_path(note_month: @next_note_month.strftime("%Y-%m"), anchor: "weekly-score-notes-heading"), class: "button button-secondary" %>
            <% else %>
              <span></span>
            <% end %>
          </nav>

          <div class="weekly-score-note-list">
          <% @note_points.reverse_each do |point| %>
            <% week_start_on = point.fetch(:week_start_on) %>
            <% note = @weekly_score_notes_by_week[week_start_on] %>
            <article id="weekly-score-note-<%= week_start_on %>" class="weekly-score-note <%= 'has-note' if note %>">
              <div class="weekly-score-note-summary">
                <div>
                  <time datetime="<%= week_start_on %>"><%= score_date_label(week_start_on) %> 週</time>
                  <span>全体平均 <strong><%= number_with_precision(point.fetch(:value), precision: 2) %></strong></span>
                </div>
                <% if note %>
                  <div class="weekly-score-note-body"><%= simple_format(note.body) %></div>
                  <small><%= note.author.name %>が<%= l(note.created_at, format: :short) %>に記録</small>
                <% else %>
                  <p class="weekly-score-note-empty">メモはありません</p>
                <% end %>
              </div>

              <% if current_user.system_admin? %>
                <details class="weekly-score-note-editor" <%= 'open' unless note %>>
                  <summary><%= note ? 'メモを編集' : 'この週にメモを追加' %></summary>
                  <%= form_with model: (note || WeeklyScoreNote.new),
                                url: note ? admin_weekly_score_note_path(note) : admin_weekly_score_notes_path,
                                method: note ? :patch : :post do |form| %>
                    <%= form.hidden_field :week_start_on, value: week_start_on %>
                    <%= form.text_area :body,
                                       value: note&.body,
                                       rows: 4,
                                       maxlength: WeeklyScoreNote::MAX_LENGTH,
                                       placeholder: "例：組織変更の告知を実施。翌週以降の推移を確認する。",
                                       aria: { label: "#{score_date_label(week_start_on)}週のメモ" } %>
                    <div class="weekly-score-note-actions">
                      <%= form.submit(note ? "更新する" : "保存する", class: "button button-primary") %>
                    </div>
                  <% end %>
                  <% if note %>
                    <div class="weekly-score-note-actions">
                      <%= button_to "削除する", admin_weekly_score_note_path(note), method: :delete,
                                    class: "button button-secondary", form: { data: { turbo_confirm: "この週次メモを削除しますか？" } } %>
                    </div>
                  <% end %>
                </details>
              <% end %>
            </article>
          <% end %>
          </div>
        </div>
      </details>
      </section>

      <div class="team-score-card-grid">
        <% @team_cards.each_with_index do |card, index| %>
          <% latest = card.fetch(:latest) %>
          <section class="team-score-card" aria-labelledby="team-score-card-<%= index %>">
            <div class="team-score-card-header">
              <div>
                <h2 id="team-score-card-<%= index %>"><%= card.fetch(:group_name) %></h2>
                <span><%= score_date_label(latest.week_start_on) %> 週</span>
              </div>
              <div class="team-score-card-metric">
                <strong><%= number_with_precision(latest.overall_average, precision: 2) %></strong>
                <span class="team-score-delta <%= score_delta_class(card.fetch(:delta)) %>"><%= score_delta_text(card.fetch(:delta)) %></span>
              </div>
            </div>

            <div class="team-score-mini-chart" role="img" aria-label="<%= card.fetch(:group_name) %>の週次推移">
              <svg viewBox="0 0 400 130" aria-hidden="true">
                <%# Y軸グリッドとラベル（1・3・5） %>
                <% mini_chart_y_axis.each do |item| %>
                  <line x1="36" y1="<%= item[:y] %>" x2="388" y2="<%= item[:y] %>"
                        class="<%= item[:score] == 1 ? 'team-score-chart-axis' : 'team-score-chart-grid' %>" />
                  <text x="30" y="<%= item[:y] + 4 %>" class="team-score-chart-label-y team-score-mini-label"><%= item[:score] %></text>
                <% end %>
                <%# Y軸縦線 %>
                <line x1="36" y1="12" x2="36" y2="118" class="team-score-chart-axis" />
                <%# データ折れ線と点 %>
                <% mini_pts = mini_chart_points(card.fetch(:points)) %>
                <polyline points="<%= mini_pts.map { |p| "#{p[:x]},#{p[:y]}" }.join(' ') %>" class="team-score-chart-line" />
                <% mini_pts.each do |point| %>
                  <circle cx="<%= point[:x] %>" cy="<%= point[:y] %>" r="4" class="team-score-chart-dot" />
                <% end %>
              </svg>
            </div>

            <div class="team-score-question-bars">
              <% @question_labels.each do |order_index, label| %>
                <% question = card.fetch(:question_averages)[order_index] %>
                <% value = question&.fetch("average") %>
                <div class="team-score-question-row">
                  <span><%= label %></span>
                  <div class="team-score-question-track" aria-hidden="true">
                    <div class="team-score-question-fill" style="width: <%= score_percent(value) %>%"></div>
                  </div>
                  <strong><%= value ? number_with_precision(value, precision: 2) : "-" %></strong>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>

      <% @scores_by_group.each_with_index do |(group_name, scores), index| %>
        <section class="team-score-group" aria-labelledby="team-score-group-<%= index %>">
          <div class="team-score-group-header">
            <h2 id="team-score-group-<%= index %>"><%= group_name %> 詳細</h2>
            <span>累計 <%= scores.sum(&:response_count) %> 件の回答</span>
          </div>
          <div class="team-score-table-wrap">
            <table class="team-score-table">
              <thead>
                <tr>
                  <th>週</th>
                  <th>全体平均</th>
                  <th>回答数</th>
                  <% @question_labels.each_value do |label| %>
                    <th><%= label %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% scores.sort_by(&:week_start_on).reverse_each do |score| %>
                  <tr>
                    <td><%= score_date_label(score.week_start_on) %></td>
                    <td><strong><%= number_with_precision(score.overall_average, precision: 2) %></strong></td>
                    <td><%= score.response_count %></td>
                    <% @question_labels.each_key do |order_index| %>
                      <% question = score.question_averages[order_index] %>
                      <td><%= question ? number_with_precision(question.fetch("average"), precision: 2) : "-" %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <section class="team-score-question-legend" aria-labelledby="team-score-question-legend-heading">
        <div>
          <p class="team-score-kicker">Questions</p>
          <h2 id="team-score-question-legend-heading">設問対応表</h2>
        </div>
        <dl>
          <% @question_descriptions.each_value do |question| %>
            <div>
              <dt><%= question.fetch(:label) %></dt>
              <dd><%= question.fetch(:body) %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% else %>
      <div class="team-score-empty">
        <h2>集計データはまだありません</h2>
        <p>Render Cronで週次集計が実行されると、ここにチーム別の推移が表示されます。</p>
      </div>
    <% end %>
  </section>
</main>
