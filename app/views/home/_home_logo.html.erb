<div class="home-logo-area">
  <%= link_to root_path, class: "home-logo-link", aria: { label: "ホームへ戻る" } do %>
    <div class="home-logo-mark" role="img" aria-label="Pulseee Pulse Survey">
      <div class="home-logo-word">
        <span>Puls</span>
        <svg class="home-logo-pulse" xmlns="http://www.w3.org/2000/svg" width="50" height="60" viewBox="0 0 50 60" aria-hidden="true">
          <polyline points="0,30 6,30 11,30 16,8 21,52 26,30 31,30 35,17 40,43 45,30 50,30"
                    stroke="#c07070"
                    stroke-width="1.4"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round" />
        </svg>
        <span>eee</span>
      </div>
      <div class="home-logo-subtitle">Pulse Survey System</div>
    </div>
  <% end %>
</div>
